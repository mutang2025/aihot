APP_NAME=AIHOT
APP_VERSION=0.1.0
DEBUG=false

# database: reuse postgresql container in 1panel-network
DATABASE_URL=postgresql+asyncpg://lgc2025:lgc2025_pass_pg@postgresql:5432/aihot

# redis
REDIS_URL=redis://aihot-redis:6379/0

# LLM endpoints
QWENPAW_BASE_URL=http://host.docker.internal:8088/v1
QWENPAW_API_KEY=not-needed
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=not-needed
DEFAULT_MODEL=qwen3-max

# auth (CHANGE in prod)
ADMIN_USER=aihot
ADMIN_PASS=__SET_ME__
SESSION_SECRET=change-me-32-chars-random-string

# Feishu push (v1.0)
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# SMTP (v1.1)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# scheduling
SCRAPER_INTERVAL_MINUTES=30
DIGEST_SEND_HOUR=8
DIGEST_TIMEZONE=Asia/Shanghai
EMBEDDING_DIM=1024
SIMILARITY_THRESHOLD=0.82
AGNES_API_KEY=sk-3jYoeaF6dmoQ582J1bjNTnAqDy35HX35VpUPFQ5DDk9njvTY
